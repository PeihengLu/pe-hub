# Copy to env.sh and edit. Sourced by submit.sh and sbatch jobs.
#   cp scripts/cluster/oxford-arc/env.sh.example scripts/cluster/oxford-arc/env.sh
#
# Keep env.sh out of git (local paths / emails).

# project data root (persistent). Example: /data/myproject/$USER/pe-hub
export PE_HUB_ROOT="${PE_HUB_ROOT:-$DATA/pe-hub}"

# Conda via ARC modules (recommended). Discover with: module spider Anaconda / Mamba
export ARC_MODULES="${ARC_MODULES:-Anaconda3}"
# Prefix under $DATA (not a named env in $HOME — HOME is only 15 GiB).
export CONDA_ENV="${CONDA_ENV:-$DATA/envs/pe-hub}"
# Optional private Miniconda instead of the module:
# unset ARC_MODULES   # or omit Anaconda from ARC_MODULES
# export CONDA_ROOT="$DATA/conda"

# Optional extra modules (space-separated), e.g. CUDA if needed for builds.
# export ARC_MODULES="Anaconda3 CUDA/12.2"

# SLURM defaults for peen GPU jobs (htc only — GPUs are not on arc).
# short ≤12h (faster start); medium ≤48h; long ≤30d
export ARC_CLUSTER="${ARC_CLUSTER:-htc}"
export ARC_PARTITION="${ARC_PARTITION:-short}"
export ARC_TIME="${ARC_TIME:-12:00:00}"
# Stage 02 (merged ClinVar + library1) needs medium/48h — override at submit time:
#   ARC_PARTITION=medium ARC_TIME=48:00:00 ./scripts/cluster/oxford-arc/submit.sh 02_tune_base_l1_clinvar.sh
export ARC_GPUS="${ARC_GPUS:-1}"
# Prefer L40S (large pool, fast) or A100 for longer runs; omit for any GPU.
# export ARC_GPU_CONSTRAINT="gpu_sku:L40S"
export ARC_CPUS="${ARC_CPUS:-8}"
export ARC_MEM="${ARC_MEM:-64G}"
export ARC_MAIL_USER="${ARC_MAIL_USER:-}"   # e.g. you@unit.ox.ac.uk

# peen device (single GPU → cuda:0 inside the job)
export DEVICE="${DEVICE:-cuda:0}"
export N_TRIALS="${N_TRIALS:-20}"
export CV_FOLDS="${CV_FOLDS:-5}"
export SMOKE="${SMOKE:-0}"
export SKIP_IF_TUNED="${SKIP_IF_TUNED:-0}"
export SKIP_IF_DONE="${SKIP_IF_DONE:-0}"

# Bring results home (used by sync_from_arc.sh on your laptop):
#   export ARC_REMOTE="you@htc-login.arc.ox.ac.uk:/data/<project>/<user>/pe-hub"
# Optional: SYNC_STUDIES=1 to also pull Optuna .db files
# HPO presets write to training_presets_local/ (gitignored); rsync those, don't push routinely.
#
# DVC store (reference genomes, eval results): /data/<project>/<user>/dvc-store
# On ARC that is usually $DATA/dvc-store. setup_dvc_remote.sh writes config.local:
#   ./scripts/cluster/oxford-arc/setup_dvc_remote.sh
# Optional override: export DVC_STORE="$DATA/dvc-store"
