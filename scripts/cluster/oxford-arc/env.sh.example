# Copy to env.sh and edit. Sourced by submit.sh and sbatch jobs.
#   cp scripts/cluster/oxford-arc/env.sh.example scripts/cluster/oxford-arc/env.sh
#
# Keep env.sh out of git (local paths / emails).

# ARC project data root (persistent). Example: /data/myproject/$USER/pe-hub
export PE_HUB_ROOT="${PE_HUB_ROOT:-$DATA/pe-hub}"

# Conda: either a module + env name, or an absolute prefix under $DATA.
# Prefer installing Miniconda under $DATA (HOME is only 15 GiB).
export CONDA_ROOT="${CONDA_ROOT:-$DATA/conda}"
export CONDA_ENV="${CONDA_ENV:-pe-hub}"

# Optional ARC module loads before activating conda (space-separated).
# Discover on an interactive HTC node: module spider CUDA / Anaconda
# export ARC_MODULES="CUDA/12.2"

# SLURM defaults for peen GPU jobs (htc only — GPUs are not on arc).
export ARC_CLUSTER="${ARC_CLUSTER:-htc}"
export ARC_PARTITION="${ARC_PARTITION:-medium}"
export ARC_TIME="${ARC_TIME:-48:00:00}"
export ARC_GPUS="${ARC_GPUS:-1}"
# Prefer L40S / A100 for longer medium/long availability; omit for any GPU.
# export ARC_GPU_CONSTRAINT="gpu_sku:L40S"
export ARC_CPUS="${ARC_CPUS:-8}"
export ARC_MEM="${ARC_MEM:-64G}"
export ARC_MAIL_USER="${ARC_MAIL_USER:-}"   # e.g. you@unit.ox.ac.uk

# peen device (single GPU → cuda:0 inside the job)
export DEVICE="${DEVICE:-cuda:0}"
export N_TRIALS="${N_TRIALS:-20}"
export CV_FOLDS="${CV_FOLDS:-5}"
export SMOKE="${SMOKE:-0}"
export SKIP_IF_TUNED="${SKIP_IF_TUNED:-0}"
export SKIP_IF_DONE="${SKIP_IF_DONE:-0}"

# Bring results home (used by sync_from_arc.sh on your laptop):
#   export ARC_REMOTE="you@gateway.arc.ox.ac.uk:/data/<project>/<user>/pe-hub"
# Optional: SYNC_STUDIES=1 to also pull Optuna .db files
# HPO presets write to training_presets_local/ (gitignored); rsync those, don't push routinely.
