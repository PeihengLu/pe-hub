# Environment variables for PE-DB project

# Data paths
# Prefer DATA_ROOT/MODEL_ROOT for service configuration.
PE_PROJECT_ROOT=.
DATA_ROOT=./datasets
MODEL_ROOT=./vendor/models

# Legacy/compat paths
DATA_PATH=./datasets/standardized
MODEL_PATH=./vendor/models

# Service URLs
PE_DB_URL=http://localhost:8000
PE_ENSEMBLE_URL=http://localhost:8001

# Database service configuration
PE_DB_HOST=0.0.0.0
PE_DB_PORT=8000

# Ensemble service configuration
PE_ENSEMBLE_HOST=0.0.0.0
PE_ENSEMBLE_PORT=8001

# GPU configuration (for NVIDIA GPUs)
CUDA_VISIBLE_DEVICES=0

# Jupyter configuration
JUPYTER_TOKEN=
JUPYTER_PORT=8888

# Development mode
DEBUG=false
