@article{murrayPrimeEditingTherapeutic2025,
  title = {Prime Editing: Therapeutic Advances and Mechanistic Insights},
  shorttitle = {Prime Editing},
  author = {Murray, Joss B. and Harrison, Patrick T. and Scholefield, Janine},
  date = {2025-03},
