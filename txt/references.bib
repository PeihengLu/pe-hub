@article{yuPredictionEfficienciesDiverse2023,
  title = {Prediction of Efficiencies for Diverse Prime Editing Systems in Multiple Cell Types},
  author = {Yu, Goosang and Kim, Hui Kwon and Park, Jinman and Kwak, Hyunjong and Cheong, Yumin and Kim, Dongyoung and Kim, Jiyun and Kim, Jisung and Kim, Hyongbum Henry},
  date = {2023-05},
