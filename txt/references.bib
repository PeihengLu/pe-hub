  keywords = {/unread,Chromatin,cis x trans interactions,cis-chromatin effect,CRISPR-Cas Systems,DNA damage repair,Epigenesis Genetic,epigenome editing,Gene Editing,genome engineering,Histone Code,Histones,Humans,prime editing,Transcription Factors},
  file = {/Users/peiheng/Zotero/storage/KG53A5K7/Li et al. - 2024 - Chromatin context-dependent regulation and epigenetic manipulation of prime editing.pdf}
}

