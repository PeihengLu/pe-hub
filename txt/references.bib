  author = {Koeppel, Jonas and Weller, Juliane and Peets, Elin Madli and Pallaseni, Ananth and Kuzmin, Ivan and Raudvere, Uku and Peterson, Hedi and Liberante, Fabio Giuseppe and Parts, Leopold},
  date = {2023-10},
  journaltitle = {Nature Biotechnology},
