@article{kimPredictingEfficiencyPrime2021,
  title = {Predicting the Efficiency of Prime Editing Guide {{RNAs}} in Human Cells},
  author = {Kim, Hui Kwon and Yu, Goosang and Park, Jinman and Min, Seonwoo and Lee, Sungtae and Yoon, Sungroh and Kim, Hyongbum Henry},
  date = {2021-02},
  journaltitle = {Nature Biotechnology},
  shortjournal = {Nat Biotechnol},
  volume = {39},
  number = {2},
  pages = {198--206},
  publisher = {Nature Publishing Group},
  issn = {1546-1696},
  doi = {10.1038/s41587-020-0677-y},
  url = {https://www.nature.com/articles/s41587-020-0677-y},
  urldate = {2024-04-16},
  abstract = {Prime editing enables the introduction of virtually any small-sized genetic change without requiring donor DNA or double-strand breaks. However, evaluation of prime editing efficiency requires time-consuming experiments, and the factors that affect efficiency have not been extensively investigated. In this study, we performed high-throughput evaluation of prime editor 2 (PE2) activities in human cells using 54,836 pairs of prime editing guide RNAs (pegRNAs) and their target sequences. The resulting data sets allowed us to identify factors affecting PE2 efficiency and to develop three computational models to predict pegRNA efficiency. For a given target sequence, the computational models predict efficiencies of pegRNAs with different lengths of primer binding sites and reverse transcriptase templates for edits of various types and positions. Testing the accuracy of the predictions using test data sets that were not used for training, we found Spearman’s correlations between 0.47 and 0.81. Our computational models and information about factors affecting PE2 efficiency will facilitate practical application of prime editing.},
  langid = {english},
  keywords = {CRISPR-Cas9 genome editing,Genetic engineering,notion},
  file = {/Users/peiheng/Zotero/storage/ZMRJVB4X/Kim et al. - 2021 - Predicting the efficiency of prime editing guide R.pdf;C\:\\Users\\13954\\OneDrive\\Papers\\Kim et al. - 2021 - Predicting the efficiency of prime editing guide RNAs in human cells.pdf}
}

@article{mathisMachineLearningPrediction2024,
  title = {Machine Learning Prediction of Prime Editing Efficiency across Diverse Chromatin Contexts},
  author = {Mathis, Nicolas and Allam, Ahmed and Tálas, András and Kissling, Lucas and Benvenuto, Elena and Schmidheini, Lukas and Schep, Ruben and Damodharan, Tanav and Balázs, Zsolt and Janjuha, Sharan and Ioannidi, Eleonora I. and Böck, Desirée and family=Steensel, given=Bas, prefix=van, useprefix=true and Krauthammer, Michael and Schwank, Gerald},
  date = {2024-06-21},
  journaltitle = {Nature Biotechnology},
  shortjournal = {Nat Biotechnol},
  pages = {1--8},
  publisher = {Nature Publishing Group},
  issn = {1546-1696},
  doi = {10.1038/s41587-024-02268-2},
  url = {https://www.nature.com/articles/s41587-024-02268-2},
  urldate = {2024-06-23},
  abstract = {The success of prime editing depends on the prime editing guide RNA (pegRNA) design and target locus. Here, we developed machine learning models that reliably predict prime editing efficiency. PRIDICT2.0 assesses the performance of pegRNAs for all edit types up to 15 bp in length in mismatch repair-deficient and mismatch repair-proficient cell lines and in vivo in primary cells. With ePRIDICT, we further developed a model that quantifies how local chromatin environments impact prime editing rates.},
  langid = {english},
  keywords = {Chromatin,Epigenetics,Genetic engineering,High-throughput screening,Machine learning,notion,prime editing},
  file = {/Users/peiheng/Zotero/storage/DNZHY5LX/Mathis et al. - 2024 - Machine learning prediction of prime editing effic.pdf;/Users/peiheng/Zotero/storage/JNVLVVBW/41587_2024_2268_MOESM1_ESM.pdf}
}

