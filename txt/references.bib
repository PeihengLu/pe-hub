@article{petraityteGenomeEditingMedicine2021,
  title = {Genome {{Editing}} in {{Medicine}}: {{Tools}} and {{Challenges}}},
  shorttitle = {Genome {{Editing}} in {{Medicine}}},
  author = {Petraitytė, Gunda and Preikšaitienė, Eglė and Mikštienė, Violeta},
